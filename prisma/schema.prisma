generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Label {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  values    LabelValue[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model LabelValue {
  id        Int      @id @default(autoincrement())
  faName    String
  enName    String
  labelId   Int
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labelId])
}

model Design {
  id         Int           @id @default(autoincrement())
  name       String        @unique
  code       String        @unique
  size       String
  faceCount  Int
  mainImage  String
  images     DesignImage[]
  labelsJson Json @default("[]")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model DesignImage {
  id       Int     @id @default(autoincrement())
  designId Int
  index    Int     // شماره فیس برای نامگذاری: face_{index}
  url      String  // مسیر ذخیره تصویر: folder/name_face_{index}.png
  design   Design  @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
  @@unique([designId, index]) // هر فیس یک index یکتا برای هر طرح
}
